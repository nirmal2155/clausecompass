# ClauseCompass Environment Variables
# Copy this file to .env.local and fill in your values

# Gemini API Key (required for LLM features)
# Get yours at: https://aistudio.google.com/
# If not set, the app uses a deterministic fallback engine for all 10 test documents
GEMINI_API_KEY=

# Optional: Set to 'true' to enable verbose LLM logging
# LLM_DEBUG=false
